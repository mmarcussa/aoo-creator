{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archiveofouroverwrites.github.io/schema/aoopack-v1.json",
  "title": "Archive of Our Overwrites creator project",
  "type": "object",
  "required": ["schemaVersion", "id", "pack", "authors", "works"],
  "properties": {
    "schemaVersion": {"const": 1},
    "frameworkVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 8},
    "pack": {
      "type": "object",
      "required": ["name", "namespace", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "namespace": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 48},
        "version": {"type": "string"}
      }
    },
    "authors": {"type": "array", "minItems": 1},
    "works": {"type": "array", "minItems": 1}
  }
}
